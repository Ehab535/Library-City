rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Codes Collection ---
    match /codes/{codeId} {
      allow read, write: if true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read, write: if true;
    }

    // --- Contents Collection ---
    match /contents/{contentId}/{document=**} {
      allow read, write: if true;
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // --- Presence Collection ---
    match /presence/{userId} {
      allow read, write: if true;
    }
  }
}
